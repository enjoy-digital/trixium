# Python
__pycache__/
*.pyc
/.venv
*.egg-info/

# Build outputs (gateware, simulations, Verilator test cache)
build/

# Models / weight images (regenerable, large)
/models

# Vivado cruft
.Xil/
vivado*.jou
vivado*.log
vivado_pid*.str

# VexiiRiscv (sbt) generation leftovers
/target/
/project/

# Firmware build (make -C firmware BUILD_DIR=<build tree>): tree-specific, never tracked
firmware/*.o
firmware/*.d
firmware/*.elf
firmware/*.elf.map
firmware/trixium.bin
firmware/progs.h
firmware/.build_dir_stamp
firmware/.build.lock

# Host tools build (make -C software/user BUILD_DIR=<build tree>)
software/user/trixium_smi
software/user/trixium_load
software/user/trixium_chat
software/user/*.o
software/user/*.a
software/user/*.d
software/user/.build_config

# Simulation traces
*.vcd
*.fst
*.fst.hier
