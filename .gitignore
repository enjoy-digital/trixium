# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Build outputs
build/
firmware/build/
prog/bitstreams/*
!prog/bitstreams/.gitkeep

# Models / weight images (regenerable, large)
models/

# Vivado-generated HBM IP outputs (only the .xci is tracked).
# Each TCK variant keeps its own directory - the 31 identically named support files would
# otherwise clobber each other - and ip/hbm is a local symlink at the one the build wants,
# because USPHBM2 resolves the XCI as <cwd>/ip/hbm/<name>.xci. See trixium.py.
/ip/hbm
ip/hbm900/*
!ip/hbm900/hbm_0.xci
ip/hbm800/*
!ip/hbm800/hbm_800.xci

# Vivado FP32 IP products (regenerated from the reviewed XCI files).

# Build/convert logs at the repo root
/*.log

# Vivado cruft
.Xil/
vivado*.jou
vivado*.log
*.backup.jou
*.backup.log

# Software build artifacts
*.o
*.ko
*.so
*.mod
*.mod.c
*.cmd
.tmp_versions/
Module.symvers
modules.order

# Simulation artifacts
*.vcd
*.fst
*.fst.hier
csr.csv
analyzer.csv

# Firmware build artifacts (regenerate with: make -C firmware BUILD_DIR=../build/<tree>).
# The binary is tree-specific - CSR maps differ - so a checked-in copy is a footgun.
firmware/*.d
firmware/*.elf
firmware/*.elf.map
firmware/trixium.bin

# Host tool binaries (build with: make -C trixium/software/user BUILD_DIR=<build tree>).
trixium/software/user/trixium_util
trixium/software/user/trixium_load
trixium/software/user/trixium_chat
trixium/software/user/*.d
trixium/software/user/*.o
trixium/software/user/liblitepcie/*.d
trixium/software/user/liblitepcie/*.o
trixium/software/user/liblitepcie/*.a

# Exported Word copies of local docs (not tracked).
docs/*.docx
docs/*.doc

# Verilator unit-sim build outputs (regenerate with tools/vsim/build_vecunit.py).
tools/vsim/obj/
rom*.init
tools/vsim/obj_engine/
firmware/.build_dir_stamp
firmware/.build.lock
/trace.json
firmware/progs.h

# Vivado scratch files it drops in the CWD
vivado_pid*.str
vivado*.jou
vivado*.log
trixium/software/user/.build_config

# sbt/VexiiRiscv generation leftovers
/target/
/project/

# Per-build generated headers (copied from build/<name>/driver/kernel/ by the bring-up scripts).
trixium/software/kernel/csr.h
trixium/software/kernel/soc.h
trixium/software/kernel/mem.h
